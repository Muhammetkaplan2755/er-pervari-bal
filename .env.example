# Kopyalayıp .env.local yapın (yerel geliştirme). Canlıda bu değerleri
# Netlify / Vercel panelindeki "Environment variables" bölümüne girin.
# Gizli anahtarı (SECRET) hiçbir zaman VITE_ ile başlatmayın: tarayıcıya sızar.

# Sepette "Kredi / banka kartı" seçeneğini açar (1 = açık). Build sırasında okunur.
VITE_KART_ODEME=1

# iyzico panelinden: önce sandbox-merchant.iyzipay.com, canlıda merchant.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox: https://sandbox-api.iyzipay.com   Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# İsteğe bağlı: callback adresi için sitenin tam adresi (sonunda / olmadan)
PUBLIC_ORIGIN=

# ---------- Yönetici paneli (KURULUM-YONETIM.md) ----------
# Herkese açık (tarayıcıya gider):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# GİZLİ (yalnızca sunucu):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NETLIFY_BUILD_HOOK=
# İsteğe bağlı: WHATSAPP_NOTIFY=905xxxxxxxxx,905yyyyyyyyy   WHATSAPP_API_VERSION=v23.0
# Geçici WhatsApp bildirimi (Meta kurulana kadar). Birden çok numara: virgülle.
CALLMEBOT=905536635864:ANAHTAR
