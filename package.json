{
  "name": "er-pervari-bal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-products.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint src server scripts api netlify tests vite.config.js",
    "preview": "vite preview",
    "kontrol": "node scripts/kontrol.mjs",
    "seed": "node scripts/make-seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "check": "npm run lint && npm test && npm run scan:secrets"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-sans-arabic": "5.2.9",
