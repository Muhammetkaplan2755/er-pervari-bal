    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "vitest": "5.1.0"
  }
}
