# Netlify güvenlik başlıkları (Vercel karşılığı vercel.json "headers").
# CSP kaynakları: tüm fontlar yerel (Arapça dahil); harita için Google Maps
# iframe'i; ürün fotoğrafları ve yönetici paneli Supabase. iyzico ödeme sayfasına
# tam sayfa yönlendirme yapılır (CSP navigasyonu kısıtlamaz). Yeni bir dış kaynak
# eklerseniz buraya da ekleyin, yoksa tarayıcı engeller.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/yonetim
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/yonetim/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/odeme
  Cache-Control: no-store
  X-Robots-Tag: noindex
