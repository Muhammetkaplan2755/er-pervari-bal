# Netlify. Her sayfa ve ürün build'de kendi index.html'iyle üretilir (scripts/prerender.mjs).
# Parti kodları (QR) önceden bilinmediği için parti sayfasına yönlendirilir.
# Kartla ödeme fonksiyonları (netlify/functions).
/api/odeme-baslat  /.netlify/functions/odeme-baslat  200
/api/odeme-sonuc   /.netlify/functions/odeme-sonuc   200
/api/siparis        /.netlify/functions/siparis        200
/api/yonetim/:action  /.netlify/functions/yonetim?action=:action  200
# Yönetici paneli tek sayfa; alt adresler aynı HTML'i açar.
/yonetim/*         /yonetim/index.html               200
/parti/*  /parti/index.html  200
# Bilinmeyen adresler 404 durumuyla 404.html'i gösterir (uygulama "Sayfa bulunamadı" çizer).
/*        /404.html          404
